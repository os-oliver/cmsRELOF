      ) AS content
    FROM text t
    WHERE t.source_table = 'subcategory_document' AND t.lang IN (:lang_cat, 'sr-Cyrl')
    GROUP BY t.source_id
) sc_text ON sc_text.source_id = s.id
ORDER BY d.datetime DESC, te.field_name;

