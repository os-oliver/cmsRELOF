  sc_text.content AS name,
  c.color_code
FROM
  (SELECT d.id FROM document d
    JOIN subcategory_document s ON s.id = d.subcategory_id
    
    ORDER BY d.datetime DESC
    LIMIT 0, 15
  ) pd
